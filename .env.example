# ============================================================
# AlgoVision — Environment Variables Template
#
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in real values in your .env file
#   3. NEVER commit the .env file (it's blocked by .gitignore)
#
# This file IS safe to commit — it has no real secrets.
# It tells teammates exactly which variables they need.
# ============================================================

# ─── Database (PostgreSQL) ──────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=algovision_db
DB_USERNAME=algovision_user
DB_PASSWORD=change_me_strong_password

# ─── Redis Cache ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT Authentication ─────────────────────────────────────
# Must be at least 256 bits (32+ characters).
# Generate one at: https://generate-secret.vercel.app/64
JWT_SECRET=change_me_to_a_very_long_random_string_min_32_chars
JWT_ACCESS_TOKEN_EXPIRATION=900000      # 15 minutes in milliseconds
JWT_REFRESH_TOKEN_EXPIRATION=604800000  # 7 days in milliseconds

# ─── Spring Boot ────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ─── Frontend (Vite) ────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api/v1