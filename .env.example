# ============================================================
# AlgoVision — Environment Variables Template
#
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in real values in your .env file
#   3. NEVER commit the .env file (it is blocked by .gitignore)
#
# This file IS safe to commit — it contains no real secrets.
# ============================================================

# ─── Database (PostgreSQL) ──────────────────────────────────
# Local development: use individual host/port/name variables
# Production (Render): uses DATABASE_URL instead
DB_HOST=localhost
DB_PORT=5432
DB_NAME=algovision_db
DB_USERNAME=algovision_user
DB_PASSWORD=change_me_strong_password

# Production database URL (provided by Render automatically)
DATABASE_URL=jdbc:postgresql://host:5432/dbname?user=username&password=password

# ─── Redis ──────────────────────────────────────────────────
# Local development
REDIS_HOST=localhost
REDIS_PORT=6379

# Production Redis URL (provided by Upstash)
# Format: rediss://default:password@host.upstash.io:6380
REDIS_URL=rediss://default:password@your-host.upstash.io:6380

# ─── JWT Authentication ─────────────────────────────────────
# Generate a secure secret at: https://generate-secret.vercel.app/64
# Must be at least 32 characters
JWT_SECRET=change_me_to_a_very_long_random_string_minimum_32_characters
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# ─── JDoodle Code Execution API ─────────────────────────────
# Get credentials at: https://www.jdoodle.com/compiler-api
JDOODLE_CLIENT_ID=your_jdoodle_client_id_here
JDOODLE_CLIENT_SECRET=your_jdoodle_client_secret_here

# ─── Spring Boot ────────────────────────────────────────────
# Use 'dev' locally, 'prod' on Render
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ─── CORS ───────────────────────────────────────────────────
# Local: http://localhost:5173
# Production: your Vercel URL e.g. https://algovision.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── Frontend (Vite) ────────────────────────────────────────
# Local: http://localhost:8080/api/v1
# Production: your Render backend URL
VITE_API_BASE_URL=http://localhost:8080/api/v1